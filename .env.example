# Copy to .env before starting Docker Compose.

# The review dashboard is bound to localhost on port 8080. Set both values
# before exposing it beyond your own machine.
WORKER_PORT=8080
REVIEW_AUTH_USER=
REVIEW_AUTH_PASSWORD=

NOTION_TOKEN=

# Consumed directly by the worker container (job discovery pipeline).
OPENAI_API_KEY=
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=

# Optional discovery-pipeline tuning (worker falls back to sane defaults if unset).
DISCOVERY_QUERY=
DAILY_LEAD_CAP=
APIFY_ACTOR_ID=

# Daily discovery scheduler: off by default, same as the old n8n workflow's
# `active: false`. Set to true once you're ready for unattended daily runs
# (they spend real Firecrawl/Apify credits). Hour is UTC.
DISCOVERY_SCHEDULE_ENABLED=
DISCOVERY_HOUR_UTC=

# Host path to your resume folder, bind-mounted read-only into the worker
# at /app/resumes. Defaults to ~/Desktop/Nivish_Tailored_Resumes if unset.
RESUME_HOST_DIR=
