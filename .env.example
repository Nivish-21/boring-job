# Copy to .env before starting Docker Compose.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=n8n

# Add these later in n8n Credentials, not directly in workflows.
NOTION_TOKEN=
OPENAI_API_KEY=
APIFY_API_TOKEN=

