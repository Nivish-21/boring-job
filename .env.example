# Copy to .env before starting Docker Compose.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# The review dashboard is bound to localhost on port 8080. Set both values
# before exposing it beyond your own machine.
WORKER_PORT=8080
REVIEW_AUTH_USER=
REVIEW_AUTH_PASSWORD=

POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=n8n

# Add this later in n8n Credentials, not directly in workflows.
NOTION_TOKEN=

# Consumed directly by the worker container (job discovery pipeline) via
# compose.yml env passthrough — set here, not in n8n Credentials.
OPENAI_API_KEY=
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=

# Optional discovery-pipeline tuning (worker falls back to sane defaults if unset).
DISCOVERY_QUERY=
DAILY_LEAD_CAP=
APIFY_ACTOR_ID=

# Host path to your resume folder, bind-mounted read-only into the worker
# at /app/resumes. Defaults to ~/Desktop/Nivish_Tailored_Resumes if unset.
RESUME_HOST_DIR=
